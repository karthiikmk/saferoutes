rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Config rules - allows read/write for authenticated users
    match /config/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Parking pins rules - readable and writeable by authenticated users
    match /parking_pins/{pinId} {
      allow read, write: if request.auth != null;
    }
    
    // User scope rules - isolated to the authenticated user's email matching request.auth.token.email
    match /users/{cleanEmail} {
      allow read, write: if request.auth != null;
      
      match /route_history/{routeId} {
        allow read, write: if request.auth != null && 
          (resource == null || resource.data.userEmail == request.auth.token.email) && 
          (request.resource == null || request.resource.data.userEmail == request.auth.token.email);
      }
      
      match /vehicles/{regNum} {
        allow read, write: if request.auth != null && 
          (resource == null || resource.data.userEmail == request.auth.token.email) && 
          (request.resource == null || request.resource.data.userEmail == request.auth.token.email);
      }
    }
  }
}
